welcome =
    <b>☕ Start looking for a chat partner!</b>
    <i>👀 Users searching:</i> <code>{$searchers}</code>

search = ☕ Find a chat partner
leave = 🚫 Leave the chat
cancel = ❌ Cancel search

dialog_active =
    <b>☕ You already have an active chat</b>
    <i>Use the /leave command to leave the chat</i>

search_started =
    <b>👀 Looking for a chat partner...</b>
    <i>/cancel - Cancel the search</i>

interlocutor_found =
    <b>🎁 I found you a chat partner. Have a great conversation!</b>
    <i>/next - Find the next partner</i>
    <i>/leave - Leave the chat</i>

already_searching =
    <b>👀 I'm already looking for a chat partner...</b>
    <i>/cancel - Cancel the search</i>

no_search_now = <b>😔 Alright... I won't search for anyone anymore!</b>

you_leave = <b>💬 You left the chat!</b>

interlocutor_leave = <b>💬 Your chat partner left the chat!</b>